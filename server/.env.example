# =============================================================================
# DATABASE_URL — PostgreSQL connection string
# =============================================================================
# Official format (per https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING):
#   postgresql://username:password@host:port/database?param1=value1&param2=value2
#
# Values below match the default docker-compose.yml in /database.
# When connecting from inside the Docker network, replace "localhost" with "postgres"
# (the service name) and omit the port:
#   postgresql://fulltime:fulltime@postgres:5432/fulltime?schema=public
# =============================================================================

DATABASE_URL="postgresql://fulltime:fulltime@localhost:5432/fulltime?schema=public"
