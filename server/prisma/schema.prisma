generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeasonStatus {
  INITIALIZED
  IN_PROGRESS
  COMPLETED
}

enum MatchdayStatus {
  PENDING
  SIMULATED
}

enum FixtureStatus {
  PENDING
  SIMULATED
}

enum MatchStatus {
  COMPLETED
}

model Season {
  id          String        @id @default(uuid())
  startDate   DateTime
  status      SeasonStatus  @default(INITIALIZED)
  createdAt   DateTime      @default(now())
  matchdays   Matchday[]
  clubs       Club[]
}

model Matchday {
  id        String           @id @default(uuid())
  seasonId  String
  index     Int              // 1-38
  status    MatchdayStatus   @default(PENDING)
  season    Season           @relation(fields: [seasonId], references: [id])
  fixtures  Fixture[]

  @@unique([seasonId, index])
  @@index([seasonId])
}

model Fixture {
  id          String         @id @default(uuid())
  matchdayId  String
  homeClubId  String
  awayClubId  String
  status      FixtureStatus  @default(PENDING)
  seed        Int            // PRNG seed for deterministic simulation
  matchId     String?        // populated after simulation
  matchday    Matchday       @relation(fields: [matchdayId], references: [id])
  homeClub    Club           @relation("HomeFixtures", fields: [homeClubId], references: [id])
  awayClub    Club           @relation("AwayFixtures", fields: [awayClubId], references: [id])
  match       Match?

  @@index([matchdayId])
  @@index([homeClubId])
  @@index([awayClubId])
}

model Match {
  id            String      @id @default(uuid())
  fixtureId     String      @unique
  homeScore     Int
  awayScore     Int
  eventLogJson  String      // JSON string of MatchEvent[]
  status        MatchStatus @default(COMPLETED)
  simulatedAt   DateTime    @default(now())
  fixture       Fixture     @relation(fields: [fixtureId], references: [id])
}

model Club {
  id            String          @id @default(uuid())
  name          String
  seasonId      String
  season        Season          @relation(fields: [seasonId], references: [id])
  players       Player[]
  startingXI    StartingXI?
  homeFixtures  Fixture[]       @relation("HomeFixtures")
  awayFixtures  Fixture[]       @relation("AwayFixtures")

  @@index([seasonId])
}

model StartingXI {
  id          String   @id @default(uuid())
  clubId      String   @unique
  playerIds   Json     // Array of player UUIDs (11 players)
  computedAt  DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id])
}

model Player {
  id                      String  @id @default(uuid())
  clubId                  String
  name                    String
  positionGroup           String  // GK, DEF, MID, FWD
  attack                  Int
  defense                 Int
  passing                 Int
  physical                Int
  goalkeeping             Int
  overallRating           Float
  club                    Club    @relation(fields: [clubId], references: [id])

  @@index([clubId])
}

